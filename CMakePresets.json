{
  "version": 3,
  "configurePresets": [
    {
      "name": "adv",
      "displayName": "Cardputer ADV (240x135)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "SCREEN_W": "240",
        "SCREEN_H": "135"
      }
    },
    {
      "name": "zero",
      "displayName": "Cardputer Zero simulator (320x170)",
      "binaryDir": "${sourceDir}/build_zero",
      "cacheVariables": {
        "CARDPUTER_ZERO": "ON"
      }
    },
    {
      "name": "zero-device",
      "displayName": "Cardputer Zero Linux device",
      "inherits": "zero",
      "binaryDir": "${sourceDir}/build_zero_device",
      "cacheVariables": {
        "CARDPUTER_ZERO_DEVICE": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "adv", "configurePreset": "adv" },
    { "name": "zero", "configurePreset": "zero" },
    { "name": "zero-device", "configurePreset": "zero-device" }
  ]
}
